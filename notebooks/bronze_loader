# Databricks notebook source
# COMMAND ----------
# Cell 1 imports and path configs
from pyspark.sql.functions import col, current_timestamp

SOURCE_PATH = "/Volumes/workspace/fintech_bronze/landing_files/transactions/"
CHECKPOINT_PATH = "/Volumes/workspace/fintech_bronze/checkpoints/bronze_stream/"

# COMMAND ----------
# Cell 2 Auto Loader read stream
bronze_stream = (
    spark.readStream
    .format("cloudFiles")
    .option("cloudFiles.format", "json")
    .option("cloudFiles.schemaLocation", f"{CHECKPOINT_PATH}/schema")
    .option("cloudFiles.inferColumnTypes", "true")
    .option("cloudFiles.schemaEvolutionMode", "addNewColumns")
    .load(SOURCE_PATH)
    .withColumn("ingested_at", current_timestamp())
)

# COMMAND ----------
# Cell 3 writeStream to Delta Table
bronze_query = (
    bronze_stream.writeStream
    .format("delta")
    .outputMode("append")
    .trigger(availableNow=True)
    .option("checkpointLocation", f"{CHECKPOINT_PATH}/stream")
    .toTable("workspace.fintech_bronze.raw_transactions")
)

bronze_query.awaitTermination()
